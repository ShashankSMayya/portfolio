---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const DEFAULT_IMAGE = '/og.jpg';
const { title, description, image = DEFAULT_IMAGE, ogType = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image ?? DEFAULT_IMAGE, Astro.site);
const isDefaultImage = (image ?? DEFAULT_IMAGE) === DEFAULT_IMAGE;
const imageAlt = 'Shashank S Mayya, full-stack mobile engineer: "I build apps where bugs cost real money."';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- Icons -->
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#0B0B0D" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Shashank S Mayya" />
<meta name="robots" content="index, follow, max-image-preview:large" />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" type="application/rss+xml" title="Shashank S Mayya" href={new URL('rss.xml', Astro.site)} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Shashank S Mayya" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{isDefaultImage && <meta property="og:image:type" content="image/jpeg" />}
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={isDefaultImage ? imageAlt : title} />

<!-- X / Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={isDefaultImage ? imageAlt : title} />
<meta name="twitter:site" content="@ShashankMayya" />
<meta name="twitter:creator" content="@ShashankMayya" />

<!-- Structured Data for Personal Profile -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Shashank S Mayya",
  "url": "https://shashanksmayya.dev",
  "image": "https://shashanksmayya.dev/profile.webp",
  "email": "mailto:shashanksmayya@gmail.com",
  "sameAs": [
    "https://x.com/ShashankMayya",
    "https://github.com/ShashankSMayya",
    "https://www.linkedin.com/in/shashank-mayya"
  ],
  "jobTitle": "Full-Stack Mobile Engineer",
  "worksFor": {
    "@type": "Organization",
    "name": "Freelance"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Mangalore",
    "addressRegion": "Karnataka",
    "addressCountry": "India"
  },
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "AJ Institute of Engineering and Technology"
  },
  "knowsAbout": [
    "Flutter Development",
    "Mobile App Development",
    "Cross-platform Development",
    "Fintech Applications",
    "Trading Applications",
    "Enterprise Solutions",
    "iOS Development",
    "Android Development",
    "Dart Programming",
    "Firebase",
    "Backend Development",
    "System Design",
    "Software Architecture",
    "Cloud Functions",
    "AI Integration",
    "LLM Applications",
    "AI-Assisted Development",
    "UX-Driven Development",
    "REST APIs",
    "WebSockets",
    "State Management",
    "BLoC Pattern",
    "GetX",
    "Performance Optimization"
  ],
  "description": "Full-stack mobile engineer with 5+ years of experience building Flutter apps end to end, from backend and system architecture to AI features, for fintech, trading, and consumer products. Available for freelance projects."
}
</script>

<!-- Performance and Optimization -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" />
