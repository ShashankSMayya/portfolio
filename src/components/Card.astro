---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<article class="group relative w-full md:w-1/3">
  {img && (
    <div class="aspect-[16/10] overflow-hidden rounded-xl border border-base-300 bg-base-200">
      <Image width={750} height={469} format="webp" src={img} alt="" class="h-full w-full object-cover" />
    </div>
  )}
  <h2 class="mt-4 text-lg font-semibold text-base-content transition-colors group-hover:text-primary">
    <a href={url} target={target} class="after:absolute after:inset-0">{title}</a>
  </h2>
  {badge && <p class="mt-1 text-sm text-base-content/45">{badge}</p>}
  {desc && <p class="mt-2 text-[15px] leading-relaxed text-base-content/65">{desc}</p>}
  {tags && tags.length > 0 && <p class="mt-3 text-sm text-base-content/45">{tags.join(", ")}</p>}
</article>
