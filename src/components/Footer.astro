---
const year = new Date().getFullYear();
const links = [
  { href: "https://github.com/ShashankSMayya", label: "GitHub" },
  { href: "https://www.linkedin.com/in/shashank-mayya", label: "LinkedIn" },
  { href: "https://x.com/ShashankMayya", label: "X" },
  { href: "mailto:shashanksmayya@gmail.com", label: "Email" },
];
---

<footer class="mt-24 border-t border-base-300/70">
  <div class="mx-auto flex max-w-[1120px] flex-col gap-4 px-5 py-10 text-sm text-base-content/55 sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>&copy; {year} Shashank S Mayya. Based in Mangalore, working with teams worldwide.</p>
    <ul class="flex gap-5">
      {links.map((l) => (
        <li>
          <a href={l.href} class="hover:text-base-content transition-colors" {...(l.href.startsWith("http") && { target: "_blank", rel: "noopener" })}>{l.label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>
