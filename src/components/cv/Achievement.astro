---
const { title, subtitle, link, linkTitle } = Astro.props;
---

<article class="border-t border-base-300 py-6 first:border-t-0 first:pt-0">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <h3 class="font-medium text-base-content">{title}</h3>
    {subtitle && <p class="shrink-0 text-sm text-base-content/50">{subtitle}</p>}
  </div>
  <div class="mt-2 text-[15px] leading-relaxed text-base-content/65">
    <slot />
  </div>
  {link && (
    <a href={link} target="_blank" rel="noopener" class="link-quiet mt-3 inline-block text-sm">{linkTitle}</a>
  )}
</article>
