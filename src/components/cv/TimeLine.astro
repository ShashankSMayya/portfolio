---
const { title, org, period } = Astro.props;
---

<article class="border-t border-base-300 py-7 first:border-t-0 first:pt-0">
  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <div>
      <h3 class="text-lg font-medium text-base-content">{title}</h3>
      {org && <p class="mt-0.5 text-[15px] text-base-content/55">{org}</p>}
    </div>
    {period && <p class="shrink-0 text-sm text-base-content/50 sm:text-right">{period}</p>}
  </div>
  <div class="mt-3 text-[15px] leading-relaxed text-base-content/70">
    <slot />
  </div>
</article>
