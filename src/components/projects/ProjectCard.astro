---
import { Image } from "astro:assets";
import type { Project } from "../../data/projects";

const { project } = Astro.props as { project: Project };
const caseStudyUrl = `/projects/${project.id}`;
const hiddenTags = new Set(["Client", "Personal", "Consumer App"]);
const stack = project.tags.filter((t) => !hiddenTags.has(t)).slice(0, 4).join(", ");
const status = project.badge
  ? project.badge.charAt(0) + project.badge.slice(1).toLowerCase()
  : undefined;
---

<article class="group relative grid gap-6 py-10 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-10">
  <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-base-300 bg-base-200">
    {project.img && (
      <Image
        src={project.img}
        width={750}
        height={469}
        format="webp"
        alt=""
        class="h-full w-full object-cover"
      />
    )}
  </div>

  <div class="flex min-w-0 flex-col">
    <p class="text-sm text-base-content/45">
      {project.date.getFullYear()}{status && <><span class="mx-2 text-base-content/25" aria-hidden="true">/</span>{status}</>}
    </p>
    <h3 class="mt-2 text-2xl font-semibold text-base-content transition-colors group-hover:text-primary">
      <a href={caseStudyUrl} class="after:absolute after:inset-0 focus-visible:outline-none">
        {project.title}
      </a>
    </h3>
    <p class="mt-3 max-w-[60ch] leading-relaxed text-base-content/65">{project.desc}</p>
    {stack && <p class="mt-4 text-sm text-base-content/45">{stack}</p>}

    <div class="relative z-10 mt-6 flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
      <a href={caseStudyUrl} class="link-quiet font-medium">Read case study</a>
      {project.appStore && (
        <a href={project.appStore} target="_blank" rel="noopener noreferrer" class="rounded-md border border-base-300 px-2.5 py-1 text-base-content/70 transition-colors hover:border-base-content/40 hover:text-base-content">App Store</a>
      )}
      {project.playStore && (
        <a href={project.playStore} target="_blank" rel="noopener noreferrer" class="rounded-md border border-base-300 px-2.5 py-1 text-base-content/70 transition-colors hover:border-base-content/40 hover:text-base-content">Google Play</a>
      )}
    </div>
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid oklch(var(--p));
    outline-offset: 4px;
    border-radius: 12px;
  }
</style>
