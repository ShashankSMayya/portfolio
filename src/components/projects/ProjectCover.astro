---
// Project cover drawn from real screenshots, so it follows the light/dark theme.
// The baked `project.img` is still used for link previews (og:image).
import type { Project } from "../../data/projects";

interface Props {
  project: Project;
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const cover = project.cover!;
const [first, second] = cover.shots;
const loading = eager ? "eager" : "lazy";
---

<div class={`cover cover--${cover.layout}`} style={`--accent: ${cover.accent}`} aria-hidden="true">
  <div class="cover__grid"></div>

  {cover.layout === "logo" && (
    <img class="logo" src={first} alt="" loading={loading} decoding="async" />
  )}

  {cover.layout === "phone" && (
    <div class="phone phone--solo"><img src={first} alt="" loading={loading} decoding="async" /></div>
  )}

  {cover.layout === "split" && (
    <>
      <div class="phone phone--left"><img src={first} alt="" loading={loading} decoding="async" /></div>
      <div class="phone phone--right"><img src={second} alt="" loading={loading} decoding="async" /></div>
    </>
  )}

  {cover.layout === "panels" && (
    <>
      <div class="panel panel--left"><img src={first} alt="" loading={loading} decoding="async" /></div>
      <div class="panel panel--right"><img src={second} alt="" loading={loading} decoding="async" /></div>
    </>
  )}

  {cover.layout === "tablet" && (
    <div class="tablet"><img src={first} alt="" loading={loading} decoding="async" /></div>
  )}

  {(cover.layout === "browser" || cover.layout === "combo") && (
    <div class="browser">
      <div class="browser__bar"><i></i><i></i><i></i></div>
      <img src={first} alt="" loading={loading} decoding="async" />
    </div>
  )}

  {cover.layout === "combo" && (
    <div class="phone phone--combo"><img src={second} alt="" loading={loading} decoding="async" /></div>
  )}
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: size;
    background:
      radial-gradient(70% 90% at 50% 100%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
      color-mix(in oklab, var(--accent) 7%, oklch(var(--b2)));
  }
  .cover__grid {
    position: absolute;
    inset: 0;
    opacity: 0.07;
    background-image:
      linear-gradient(oklch(var(--bc)) 1px, transparent 1px),
      linear-gradient(90deg, oklch(var(--bc)) 1px, transparent 1px);
    background-size: 8cqh 8cqh;
    mask-image: radial-gradient(60% 70% at 50% 60%, #000, transparent);
  }
  .cover img { display: block; }

  /* Devices rise from the bottom edge and bleed off it. */
  .phone, .tablet, .panel, .browser {
    position: absolute;
    background: #0b0b0d;
    box-shadow:
      0 0 0 1px color-mix(in oklab, oklch(var(--bc)) 14%, transparent),
      0 2cqh 6cqh color-mix(in oklab, #000 28%, transparent);
  }
  .phone { top: 14cqh; padding: 1.3cqh; border-radius: 6cqh; }
  .phone img { height: 100cqh; width: auto; border-radius: 4.8cqh; }
  .phone--solo { left: 50%; transform: translateX(-50%); }
  .phone--left { left: 50%; transform: translateX(-104%) translateY(5cqh) rotate(-3deg); }
  .phone--right { left: 50%; transform: translateX(4%) rotate(3deg); }

  .panel { top: 12cqh; border-radius: 3.5cqh; overflow: hidden; }
  .panel img { height: 100cqh; width: auto; }
  .panel--left { left: 50%; transform: translateX(-102%) translateY(5cqh) rotate(-3deg); }
  .panel--right { left: 50%; transform: translateX(2%) rotate(3deg); }

  .tablet { top: 12cqh; left: 50%; transform: translateX(-50%); padding: 1.6cqh; border-radius: 4cqh; }
  .tablet img { height: 110cqh; width: auto; border-radius: 2.4cqh; }

  .browser { top: 14cqh; left: 50%; transform: translateX(-50%); width: 80cqw; border-radius: 1.8cqh 1.8cqh 0 0; overflow: hidden; background: #1a1d26; }
  .browser__bar { display: flex; gap: 0.9cqh; align-items: center; height: 5cqh; padding: 0 1.8cqh; }
  .browser__bar i { width: 1.4cqh; height: 1.4cqh; border-radius: 50%; background: rgba(255, 255, 255, 0.22); }
  .browser img { width: 100%; height: auto; }

  .cover--combo .browser { left: 8cqw; transform: none; width: 66cqw; top: 18cqh; }
  .phone--combo { left: auto; right: 9cqw; top: 10cqh; transform: rotate(3deg); }
  .phone--combo img { height: 92cqh; }

  .logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 42cqh;
    height: 42cqh;
    transform: translate(-50%, -50%);
    border-radius: 10cqh;
    box-shadow: 0 3cqh 8cqh color-mix(in oklab, var(--accent) 45%, transparent);
  }
</style>
