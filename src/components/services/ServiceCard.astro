---
const { title, desc, features, badge } = Astro.props;
---

<div class="grid gap-4 py-7 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-12">
  <div>
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-lg font-medium text-base-content">{title}</h3>
      {badge && <span class="text-sm text-base-content/45">{badge}</span>}
    </div>
    <p class="mt-1.5 max-w-[52ch] text-[15px] leading-relaxed text-base-content/60">{desc}</p>
  </div>
  {features && features.length > 0 && (
    <ul class="grid gap-1.5 text-[15px] text-base-content/70 sm:grid-cols-2 md:grid-cols-1">
      {features.map((feature) => (
        <li class="flex gap-3">
          <span class="mt-[0.6em] h-px w-3 flex-shrink-0 bg-base-content/35" aria-hidden="true"></span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  )}
</div>
