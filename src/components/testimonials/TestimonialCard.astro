---
import { Image } from "astro:assets";

const { img, name, role, company, location, testimonial } = Astro.props;
---

<figure class="grid gap-6 py-12 md:grid-cols-[14rem_minmax(0,1fr)] md:gap-12">
  <figcaption class="flex items-center gap-4 md:flex-col md:items-start md:gap-3">
    {img && (
      <Image
        src={img}
        width={96}
        height={96}
        format="webp"
        alt=""
        class="h-12 w-12 flex-shrink-0 rounded-full border border-base-300 object-cover"
      />
    )}
    <div class="text-sm">
      <p class="font-medium text-base-content">{name}</p>
      <p class="mt-0.5 text-base-content/55">{role}{company && <>, {company}</>}</p>
      {location && <p class="mt-0.5 text-base-content/40">{location}</p>}
    </div>
  </figcaption>
  <blockquote class="max-w-[64ch] text-lg leading-[1.7] text-base-content/80 sm:text-xl sm:leading-[1.65]">
    <p>“{testimonial}”</p>
  </blockquote>
</figure>
