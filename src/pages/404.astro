---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404: Not Found">
  <section class="py-16 sm:py-24">
    <h1 class="text-[clamp(5rem,16vw,10rem)] font-semibold leading-none tracking-[-0.05em]">404</h1>
    <p class="mt-6 max-w-[48ch] text-lg text-base-content/65">This page doesn't exist. It may have moved, or the link is wrong.</p>
    <a href="/" class="mt-10 inline-block rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Go to the home page</a>
  </section>
</BaseLayout>
