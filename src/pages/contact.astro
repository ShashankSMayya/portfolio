---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Book a Call with Shashank S Mayya"
  description="Book a free intro call or send a message about your app, backend, or AI project. I reply within 24 hours."
  sideBarActiveItemID="contact"
>
  <header class="pb-12 pt-4">
    <p class="mb-6 flex items-center gap-2.5 text-sm text-base-content/60">
      <span class="signal" aria-hidden="true"></span>
      Currently available
    </p>
    <h1 class="text-4xl font-semibold sm:text-5xl">Let's talk</h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-base-content/65 sm:text-xl">
      Pick a time that works for you. We'll go over your project, and I'll give you a straight answer on scope, timeline, and whether I'm the right fit.
    </p>
  </header>

  <!-- Cal.com Inline Embed -->
  <section aria-label="Schedule a call">
    <div id="cal-booking" class="w-full overflow-hidden rounded-xl border border-base-300" style="min-height: 640px;"></div>
    <p class="mt-4 text-sm text-base-content/55">
      Booking not loading?{" "}
      <a href="https://cal.com/shashank-s-mayya" target="_blank" rel="noopener" class="link-quiet">Open my calendar directly</a>
    </p>
  </section>

  <section class="mt-24 grid gap-8 border-t border-base-300 pt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16" aria-labelledby="write-title">
    <div>
      <h2 id="write-title" class="text-2xl font-semibold sm:text-3xl">Prefer to write instead?</h2>
      <p class="mt-3 text-base-content/60">
        Or email me directly at{" "}
        <a href="mailto:shashanksmayya@gmail.com" class="link-quiet">shashanksmayya@gmail.com</a>{" "}
        or find me on <a href="https://www.linkedin.com/in/shashank-mayya" target="_blank" rel="noopener" class="link-quiet">LinkedIn</a>.
      </p>
    </div>

    <div>
      <div id="form-success" role="status" class="mb-6 hidden rounded-lg border border-success/40 bg-success/10 px-4 py-3 text-[15px] text-base-content">
        Thanks for reaching out! I'll get back to you within 24 hours.
      </div>

      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact?sent=true"
        class="grid gap-5"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-base-content" for="name">Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name" class="w-full rounded-lg border border-base-300 bg-base-100 px-3.5 py-2.5 text-base text-base-content placeholder:text-base-content/35 transition-colors hover:border-base-content/30 focus:border-primary focus:outline-none focus-visible:outline-none focus:ring-2 focus:ring-primary/30" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-base-content" for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" class="w-full rounded-lg border border-base-300 bg-base-100 px-3.5 py-2.5 text-base text-base-content placeholder:text-base-content/35 transition-colors hover:border-base-content/30 focus:border-primary focus:outline-none focus-visible:outline-none focus:ring-2 focus:ring-primary/30" />
          </div>
        </div>

        <div>
          <label class="mb-1.5 block text-sm font-medium text-base-content" for="budget">Budget range</label>
          <select id="budget" name="budget" class="w-full rounded-lg border border-base-300 bg-base-100 px-3.5 py-2.5 text-base text-base-content placeholder:text-base-content/35 transition-colors hover:border-base-content/30 focus:border-primary focus:outline-none focus-visible:outline-none focus:ring-2 focus:ring-primary/30">
            <option value="" selected>Not sure yet</option>
            <option>Under $2,000</option>
            <option>$2,000 – $5,000</option>
            <option>$5,000 – $15,000</option>
            <option>$15,000+</option>
            <option>Ongoing / retainer</option>
          </select>
        </div>

        <div>
          <label class="mb-1.5 block text-sm font-medium text-base-content" for="message">What are you building?</label>
          <textarea id="message" name="message" required rows="6" placeholder="Tell me about your project, timeline, and what you need help with." class="w-full rounded-lg border border-base-300 bg-base-100 px-3.5 py-2.5 text-base text-base-content placeholder:text-base-content/35 transition-colors hover:border-base-content/30 focus:border-primary focus:outline-none focus-visible:outline-none focus:ring-2 focus:ring-primary/30 leading-relaxed"></textarea>
        </div>

        <div>
          <button type="submit" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">
            Send message
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<!-- Cal.com embed loader: data-astro-rerun so it re-executes after view transitions -->
<script is:inline data-astro-rerun>
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) {
        cal.ns = {}; cal.q = cal.q || [];
        d.head.appendChild(d.createElement("script")).src = A;
        cal.loaded = true;
      }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === "string") {
          cal.ns[namespace] = cal.ns[namespace] || api;
          p(cal.ns[namespace], ar);
          p(cal, ["initNamespace", namespace]);
        } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, "https://app.cal.com/embed/embed.js", "init");

  // Match the embed to the site's DaisyUI theme (ink / paper)
  var calThemeFor = function () {
    return document.documentElement.getAttribute("data-theme") === "paper" ? "light" : "dark";
  };

  Cal("init", { origin: "https://cal.com" });
  Cal("inline", {
    elementOrSelector: "#cal-booking",
    calLink: "shashank-s-mayya",
    config: { layout: "month_view", theme: calThemeFor() },
  });
  Cal("ui", {
    theme: calThemeFor(),
    cssVarsPerTheme: {
      light: { "cal-brand": "#3451D1" },
      dark: { "cal-brand": "#7C9CFF" },
    },
    hideEventTypeDetails: false,
    layout: "month_view",
  });

  // Live-sync when the visitor uses the theme toggle
  if (window.__calThemeObserver) window.__calThemeObserver.disconnect();
  window.__calThemeObserver = new MutationObserver(function () {
    Cal("ui", { theme: calThemeFor() });
  });
  window.__calThemeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style>
  .signal {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: oklch(var(--p));
    box-shadow: 0 0 0 4px oklch(var(--p) / 0.15);
  }
</style>

<!-- Show success message after Netlify form submission -->
<script is:inline data-astro-rerun>
  if (new URLSearchParams(window.location.search).get("sent") === "true") {
    const el = document.getElementById("form-success");
    if (el) {
      el.classList.remove("hidden");
      el.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }
</script>
