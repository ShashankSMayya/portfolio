---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import AchievementElement from "../components/cv/Achievement.astro";
import { Image } from "astro:assets";

const experience = [
  {
    title: "Freelance Full-Stack Mobile Engineer",
    org: "Self-Employed",
    period: "Apr 2023 - Present",
    summary:
      "Freelance product engineering across fintech, consumer, and enterprise. Currently lead engineer on Outfit Formulas (app, backend, and AI).",
    highlights: [
      "Delivered 10+ production apps end-to-end for clients across India, Canada, Ireland, and the US",
      "Built a stock trading platform for a SEBI-registered broker, serving thousands of live traders during market hours",
      "Lead engineer on Outfit Formulas across mobile and backend: Flutter app, Firestore data model and security rules, and TypeScript Cloud Functions",
      "Designed and built the Outfit Formulas community feature end to end, from data contracts to a staged, flag-gated rollout to every user",
      "Built OpenAI-powered features with validated, scored model output, and took over the FastAPI AI backend (ALI) in Oct 2026",
      "Wrote unit and widget test suites for Outfit Formulas and unit tests for the Pragati ERP client app",
      "Shipped blockchain ticketing with non-custodial wallet security and QR/NFC check-in for a European events client",
      "Integrated AI backends, real-time WebSocket pipelines, payments (RevenueCat, Stripe), and analytics (PostHog, Braze)",
      "Daily AI-assisted workflows: Claude Code with custom project skills, shared agent rules, and cross-repo code indexing",
    ],
    tech: ["Flutter", "Dart", "Firebase", "Cloud Functions", "TypeScript", "OpenAI", "Supabase", "BLoC", "WebSockets", "RevenueCat", "PostHog"],
  },
  {
    title: "Software Engineer",
    org: "Realtime Innovations, Dublin, Ireland",
    period: "Dec 2022 - Apr 2023",
    summary: "Collaborated with an international team to build the Mevolve healthcare application using Flutter and Firebase.",
    highlights: [
      "Optimized Firebase operations reducing costs by 40%",
      "Implemented custom caching with Isar Database",
      "Worked with Cloud Functions for backend operations",
      "Improved app performance and user experience",
    ],
    tech: ["Flutter", "Firebase", "Isar DB", "Cloud Functions", "Performance Optimization"],
  },
  {
    title: "Flutter App Developer",
    org: "Mindstack Technologies, Mangaluru, India",
    period: "Jul 2021 - Dec 2022",
    summary: "Built fintech apps from scratch, focused on payment systems and financial services.",
    highlights: [
      "Developed 3 fintech apps from design to production",
      "Integrated payment gateways and financial APIs",
      "Implemented BLOC architecture and dependency injection",
      "Set up CI/CD pipelines and analytics tracking",
    ],
    tech: ["Flutter", "BLoC", "Hive", "GetIt", "Payment Gateways"],
  },
];

const skills = [
  { category: "Mobile Development", items: ["Flutter", "Dart", "iOS Dev", "Android Dev", "Flutter Web"] },
  {
    category: "Backend & Database",
    items: ["Firebase", "Firestore Data Modeling", "Cloud Functions", "Security Rules", "Supabase", "TypeScript", "Hive DB", "Isar DB"],
  },
  {
    category: "AI Integration",
    items: ["OpenAI API", "Gemini", "Prompt Design", "LLM Output Validation", "Python / FastAPI", "AI-Assisted Development"],
  },
  {
    category: "Architecture & Tools",
    items: ["System Design", "BLoC Pattern", "Clean Architecture", "Unit & Widget Testing", "Git & CI/CD", "REST APIs", "WebSockets", "Product & UX Thinking"],
  },
];

const education = [
  {
    title: "Bachelor of Engineering - Computer Science",
    org: "AJ Institute of Engineering and Technology, Mangaluru",
    period: "2017 - 2024",
    body: "Computer science coursework covering software development, algorithms, and system design.",
  },
  {
    title: "Pre-University Course (Science)",
    org: "Sharada PU College, Mangaluru",
    period: "2015 - 2017",
    body: "Science stream with Mathematics, Physics, and Chemistry.",
  },
];

const facts = [
  { value: "5+", label: "Years Experience" },
  { value: "10+", label: "Apps Shipped" },
  { value: "3", label: "Fintech & Trading Platforms" },
];
---

<BaseLayout
  title="Resume | Shashank S Mayya, Full-Stack Mobile Engineer"
  description="Resume of Shashank S Mayya, full-stack mobile engineer with 5+ years across Flutter, backend, system architecture, and AI. Download the PDF."
  sideBarActiveItemID="cv"
>
  <header class="flex flex-col gap-8 pb-14 sm:flex-row sm:items-end sm:justify-between">
    <div class="flex items-start gap-5">
      <Image
        class="h-16 w-16 shrink-0 rounded-full object-cover"
        format="webp"
        width={128}
        height={128}
        src="/profile.webp"
        alt="Shashank S Mayya - Full-Stack Mobile Engineer"
      />
      <div>
        <h1 class="text-4xl font-semibold text-base-content sm:text-5xl">Shashank S Mayya</h1>
        <p class="mt-2 text-lg text-base-content/70">Full-Stack Mobile Engineer · Flutter, Firebase & AI</p>
        <p class="mt-1 text-sm text-base-content/50">Mangalore, India</p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href="/resume.pdf"
        download="Shashank-S-Mayya-Resume.pdf"
        class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90"
      >
        Download PDF
      </a>
      <a href="/contact" class="link-quiet text-sm font-medium">Contact Me</a>
      <a href="https://www.linkedin.com/in/shashank-mayya" target="_blank" rel="noopener" class="link-quiet text-sm font-medium">LinkedIn Profile</a>
    </div>
  </header>

  <section class="cv-section" aria-labelledby="cv-summary">
    <h2 id="cv-summary" class="cv-heading">Professional Summary</h2>
    <div>
      <p class="max-w-[68ch] text-lg leading-relaxed text-base-content/75">
        Full-stack mobile engineer with <strong class="font-medium text-base-content">5+ years of experience</strong> building apps where reliability matters.
        I work across the stack, from Flutter apps to <strong class="font-medium text-base-content">backend, data modeling, and system architecture</strong>,
        and design with the user's experience in mind.
        Specialized in <strong class="font-medium text-base-content">fintech, trading platforms, and AI consumer apps</strong>, including a stock trading
        platform for a SEBI-registered broker that serves thousands of live traders. <strong class="font-medium text-base-content">10+ apps shipped</strong> for
        clients across India, Canada, Ireland, and the US.
      </p>
      <dl class="mt-8 grid grid-cols-3 gap-6 border-t border-base-300 pt-6">
        {facts.map((f) => (
          <div>
            <dt class="sr-only">{f.label}</dt>
            <dd class="text-2xl font-semibold tracking-tight text-base-content">{f.value}</dd>
            <dd class="mt-1 text-sm text-base-content/55">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="cv-section" aria-labelledby="cv-experience">
    <h2 id="cv-experience" class="cv-heading">Professional Experience</h2>
    <div>
      {experience.map((job) => (
        <TimeLineElement title={job.title} org={job.org} period={job.period}>
          <p class="text-base-content/75">{job.summary}</p>
          <ul class="mt-4 space-y-2">
            {job.highlights.map((h) => (
              <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-base-content/35">{h}</li>
            ))}
          </ul>
          <p class="mt-4 text-sm text-base-content/50">{job.tech.join(", ")}</p>
        </TimeLineElement>
      ))}
    </div>
  </section>

  <section class="cv-section" aria-labelledby="cv-skills">
    <h2 id="cv-skills" class="cv-heading">Technical Expertise</h2>
    <dl class="grid gap-8 sm:grid-cols-2">
      {skills.map((group) => (
        <div>
          <dt class="font-medium text-base-content">{group.category}</dt>
          <dd class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-md border border-base-300 px-2.5 py-1 text-sm text-base-content/70">{item}</span>
            ))}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="cv-section" aria-labelledby="cv-education">
    <h2 id="cv-education" class="cv-heading">Education</h2>
    <div>
      {education.map((e) => (
        <TimeLineElement title={e.title} org={e.org} period={e.period}>
          <p>{e.body}</p>
        </TimeLineElement>
      ))}
    </div>
  </section>

  <section class="cv-section" aria-labelledby="cv-achievements">
    <h2 id="cv-achievements" class="cv-heading">Achievements & Recognition</h2>
    <div>
      <AchievementElement
        title="GDG Mangalore Speaker"
        subtitle="December 2023"
        link="https://www.linkedin.com/posts/shashank-mayya_how-to-build-scalable-flutter-applications-activity-7145424874700808192-NVH3"
        linkTitle="View on LinkedIn"
      >
        Conducted a technical talk on "Building Scalable Flutter Applications" for Google Developer Group Mangalore community.
      </AchievementElement>
      <AchievementElement
        title="IEEE Mangalore Presentation"
        subtitle="2023"
        link="http://www.youtube.com/watch?v=l5uXoizNPOA"
        linkTitle="Watch on YouTube"
      >
        Presented "Flutter BLOC State Management in Production" to IEEE Mangalore Subsection, sharing real-world implementation insights.
      </AchievementElement>
      <AchievementElement title="Flutter Mentorship Program" subtitle="2022-2023">
        Mentored a team of students in developing an IoT-based Flutter application for Rosette Smart Bottles startup.
      </AchievementElement>
    </div>
  </section>

  <section class="mt-16 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12" aria-labelledby="cv-cta">
    <h2 id="cv-cta" class="text-3xl font-semibold text-base-content">Ready to Work Together?</h2>
    <p class="mt-3 max-w-[52ch] text-base-content/65">Tell me about the product you want to build.</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a
        href="/resume.pdf"
        download="Shashank-S-Mayya-Resume.pdf"
        class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90"
      >
        Download Resume
      </a>
      <a href="/contact" class="link-quiet font-medium">Contact Me</a>
      <a href="https://www.linkedin.com/in/shashank-mayya" target="_blank" rel="noopener" class="link-quiet font-medium">LinkedIn Profile</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-section {
    display: grid;
    gap: 1.25rem;
    border-top: 1px solid oklch(var(--b3));
    padding-block: 3rem;
  }
  @media (min-width: 768px) {
    .cv-section {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .cv-heading {
    font-size: 1rem;
    font-weight: 600;
    color: oklch(var(--bc));
    line-height: 1.75rem;
  }
</style>
