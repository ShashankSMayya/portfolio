---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedProjects } from "../data/projects";

const work = getFeaturedProjects();
const hiddenTags = new Set(["Client", "Personal", "Consumer App"]);
const stackFor = (tags: string[]) => tags.filter((t) => !hiddenTags.has(t)).slice(0, 3).join(", ");

const proof = [
  {
    title: "Trading at market open",
    body: "Built the stock trading platform for a SEBI-registered broker. Thousands of traders use it live during market hours.",
  },
  {
    title: "Paying subscribers",
    body: "Lead engineer on Outfit Formulas, an AI styling app on iOS and Android, across the app, the backend, and the AI features.",
  },
  {
    title: "10+ apps in production",
    body: "Shipped for founders and teams in India, Canada, Ireland, and the US, from first sketch to store release.",
  },
];

const disciplines = [
  {
    title: "Mobile apps",
    body: "Flutter apps for iOS, Android, and web with clean architecture, tests where they matter, and the small UX details people notice without knowing why.",
  },
  {
    title: "Backend and architecture",
    body: "Firestore data models, security rules, Cloud Functions, and REST services. I design the contracts between app and server so features stay easy to change.",
  },
  {
    title: "AI features",
    body: "Chat, tagging, and generation built on OpenAI and Gemini, with output checked before it reaches users. I also use AI-assisted workflows daily to ship faster.",
  },
];
---

<BaseLayout
  sideBarActiveItemID="home"
  title="Shashank S Mayya | Full-Stack Mobile Engineer, Flutter & AI"
  description="Full-stack mobile engineer building Flutter apps, backends, and AI features. Built a trading platform used by thousands of live traders. 10+ apps shipped."
>
  <section class="intro pb-20 pt-6 sm:pb-28 sm:pt-14" aria-labelledby="hero-title">
    <p class="mb-8 flex items-center gap-2.5 text-sm text-base-content/60">
      <span class="signal" aria-hidden="true"></span>
      Taking on new projects
    </p>
    <h1 id="hero-title" class="hero-title max-w-[15ch] font-semibold text-base-content">
      I build apps where bugs cost real money.
    </h1>
    <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-base-content/65 sm:text-xl">
      I'm Shashank, a full-stack mobile engineer. I design and ship Flutter apps together with the backend,
      data model, and AI features behind them, for fintech, trading, and consumer products.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">
        Book a call
      </a>
      <a href="/projects" class="link-quiet font-medium">See my work</a>
    </div>
  </section>

  <section class="grid gap-10 border-t border-base-300 pt-10 sm:grid-cols-3 sm:gap-8" aria-label="Track record">
    {proof.map((item) => (
      <div>
        <h2 class="text-base font-medium text-base-content">{item.title}</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-base-content/60">{item.body}</p>
      </div>
    ))}
  </section>

  <section class="mt-28" aria-labelledby="work-title">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="work-title" class="text-2xl font-semibold sm:text-3xl">Selected work</h2>
      <a href="/projects" class="link-quiet text-sm">All projects</a>
    </div>
    <ul class="mt-8 border-t border-base-300">
      {work.map((project) => (
        <li class="border-b border-base-300">
          <a href={`/projects/${project.id}`} class="work-row group grid gap-1 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-baseline sm:gap-8">
            <div class="min-w-0">
              <h3 class="text-lg font-medium text-base-content transition-colors group-hover:text-primary">{project.title}</h3>
              <p class="mt-1 text-[15px] text-base-content/60">{project.tagline ?? project.desc}</p>
            </div>
            <p class="text-sm text-base-content/45 sm:text-right">
              {stackFor(project.tags)}<span class="mx-2 text-base-content/25" aria-hidden="true">/</span>{project.date.getFullYear()}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-28" aria-labelledby="disciplines-title">
    <h2 id="disciplines-title" class="text-2xl font-semibold sm:text-3xl">One person across the stack</h2>
    <p class="mt-3 max-w-[60ch] text-base-content/60">
      Most products slow down at the seams between app, backend, and design. I work on all three, so decisions get made once.
    </p>
    <div class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {disciplines.map((d) => (
        <div class="border-t border-base-300 pt-5">
          <h3 class="font-medium text-base-content">{d.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-base-content/60">{d.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-28" aria-label="Client testimonial">
    <figure class="max-w-[52rem]">
      <blockquote class="text-2xl font-medium leading-snug tracking-tight text-base-content sm:text-[28px]">
        “He consistently impressed us with his ability to think like an end user, anticipating their needs and
        incorporating valuable insights into the development process.”
      </blockquote>
      <figcaption class="mt-6 text-sm text-base-content/55">
        Abhilash, CTO at Mello
        <a href="/testimonials" class="link-quiet ml-3">More from clients</a>
      </figcaption>
    </figure>
  </section>

  <section class="mt-28 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12 sm:py-16" aria-labelledby="cta-title">
    <h2 id="cta-title" class="max-w-[20ch] text-3xl font-semibold sm:text-4xl">Have something to build?</h2>
    <p class="mt-4 max-w-[52ch] text-base-content/65">
      Tell me what you're working on. I'll tell you what it takes and whether I'm the right person to build it.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Book a call</a>
      <a href="mailto:shashanksmayya@gmail.com" class="link-quiet font-medium">shashanksmayya@gmail.com</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-title {
    font-size: clamp(2.75rem, 7vw, 5.25rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  .signal {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: oklch(var(--p));
    box-shadow: 0 0 0 4px oklch(var(--p) / 0.15);
  }
</style>
