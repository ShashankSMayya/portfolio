---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { projects, type Project } from "../../data/projects";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project }: { project: Project } = Astro.props;
const allImages = [project.img, ...(project.images || [])].filter(Boolean);
const overview = project.longDesc || project.desc;
const hiddenTags = new Set(["Client", "Personal", "Consumer App"]);
const stack = project.tags.filter((t) => !hiddenTags.has(t)).join(", ");
const status = project.badge
  ? project.badge.charAt(0) + project.badge.slice(1).toLowerCase()
  : undefined;

const links = [
  project.url && project.url !== "#" && { href: project.url, label: "Website" },
  project.appStore && { href: project.appStore, label: "App Store" },
  project.playStore && { href: project.playStore, label: "Google Play" },
  project.github && { href: project.github, label: "GitHub" },
].filter(Boolean) as { href: string; label: string }[];

const sections = [
  { id: "technical-details", title: "Technical details", body: project.techDetails },
  { id: "challenges", title: "Challenges", body: project.challenges },
  { id: "outcomes", title: "Outcomes", body: project.outcomes },
].filter((s) => s.body);
const metaDescription = (text: string, max = 158) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(" ")).replace(/[,;:]$/, "") + "…";
};
---

<BaseLayout
  title={`${project.title} Case Study | Shashank S Mayya`}
  description={metaDescription(project.desc)}
  image={project.img}
  sideBarActiveItemID="projects"
>
  <a href="/projects" class="link-quiet text-sm text-base-content/60">All work</a>

  <header class="mt-8">
    <h1 class="text-4xl font-semibold sm:text-6xl">{project.title}</h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-base-content/65 sm:text-xl">{project.tagline ?? project.desc}</p>
  </header>

  <div class="mt-10 aspect-[16/9] overflow-hidden rounded-xl border border-base-300 bg-base-200">
    <Image
      src={project.img}
      width={1200}
      height={675}
      format="webp"
      alt={`${project.title} preview`}
      class="h-full w-full object-cover"
    />
  </div>

  <div class="mt-14 grid gap-12 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
    <article class="min-w-0 max-w-[68ch]">
      <section aria-labelledby="overview">
        <h2 id="overview" class="text-2xl font-semibold">Overview</h2>
        <p class="mt-4 text-[17px] leading-[1.7] text-base-content/75">{overview}</p>
      </section>

      {allImages.length > 1 && (
        <section class="mt-12" aria-label="Screenshots">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {allImages.slice(1).map((img) => (
              <div class="overflow-hidden rounded-lg border border-base-300 bg-base-200">
                <img src={img} alt={`${project.title} screenshot`} loading="lazy" class="h-full w-full object-cover" />
              </div>
            ))}
          </div>
        </section>
      )}

      {project.features && project.features.length > 0 && (
        <section class="mt-14" aria-labelledby="features">
          <h2 id="features" class="text-2xl font-semibold">Features</h2>
          <ul class="mt-5 divide-y divide-base-300 border-y border-base-300">
            {project.features.map((feature) => (
              <li class="py-3.5 text-base-content/75">{feature}</li>
            ))}
          </ul>
        </section>
      )}

      {sections.map((s) => (
        <section class="mt-14" aria-labelledby={s.id}>
          <h2 id={s.id} class="text-2xl font-semibold">{s.title}</h2>
          <p class="mt-4 text-[17px] leading-[1.7] text-base-content/75">{s.body}</p>
        </section>
      ))}
    </article>

    <aside class="lg:order-none order-first lg:sticky lg:top-24 lg:self-start">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t border-base-300 pt-5 text-sm lg:grid-cols-1">
        <div>
          <dt class="text-base-content/45">Year</dt>
          <dd class="mt-1 text-base-content">{project.date.getFullYear()}</dd>
        </div>
        {status && (
          <div>
            <dt class="text-base-content/45">Status</dt>
            <dd class="mt-1 text-base-content">{status}</dd>
          </div>
        )}
        <div class="col-span-2 lg:col-span-1">
          <dt class="text-base-content/45">Stack</dt>
          <dd class="mt-1 leading-relaxed text-base-content">{stack}</dd>
        </div>
        {links.length > 0 && (
          <div class="col-span-2 lg:col-span-1">
            <dt class="text-base-content/45">Links</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="rounded-md border border-base-300 px-2.5 py-1 text-base-content/75 transition-colors hover:border-base-content/40 hover:text-base-content">{l.label}</a>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </aside>
  </div>

  <section class="mt-20 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12 sm:py-14" aria-labelledby="case-cta">
    <h2 id="case-cta" class="text-3xl font-semibold">Want to build something like this?</h2>
    <p class="mt-3 max-w-[52ch] text-base-content/65">
      Tell me what you have in mind and I'll give you a straight answer on scope, timeline, and fit.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Book a call</a>
      <a href="/projects" class="link-quiet font-medium">More work</a>
    </div>
  </section>
</BaseLayout>
