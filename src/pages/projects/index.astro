---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import { getAllProjects } from "../../data/projects";

const projects = getAllProjects();
---

<BaseLayout
  title="Work | Apps, Backends & AI by Shashank S Mayya"
  description="Case studies from 10+ shipped products: AI consumer apps, trading platforms, event ticketing, and ERP systems, across Flutter, backend, and AI."
  sideBarActiveItemID="projects"
>
  <header class="pb-6 pt-2">
    <h1 class="text-4xl font-semibold sm:text-5xl">Work</h1>
    <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-base-content/65">
      Client work and personal products: trading platforms, consumer apps, and internal tools.
    </p>
  </header>

  <div class="divide-y divide-base-300 border-t border-base-300">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <section class="mt-20 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12 sm:py-14" aria-labelledby="projects-cta">
    <h2 id="projects-cta" class="text-3xl font-semibold">Need something like this?</h2>
    <p class="mt-3 max-w-[52ch] text-base-content/65">
      If one of these looks like what you need, book a call and we'll scope it.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Book a call</a>
      <a href="/cv" class="link-quiet font-medium">View experience</a>
    </div>
  </section>
</BaseLayout>
