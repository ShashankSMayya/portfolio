---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/services/ServiceCard.astro";

const packages = [
  {
    name: "Flutter App Audit",
    tagline: "Fixed scope, about 1 week",
    icon: "🔍",
    desc: "A deep review of your existing Flutter app: architecture, performance, security, and code quality. You get a written report with prioritized fixes you can act on immediately, whether or not we work together after.",
    forWho: "Teams with an app that feels slow, buggy, or hard to change, or founders who inherited a codebase and want to know what they're sitting on.",
    includes: [
      "Architecture and state management review",
      "Performance profiling of real problem screens",
      "Security and data handling check",
      "Written report with prioritized, actionable fixes",
      "A call to walk through the findings together"
    ]
  },
  {
    name: "MVP Sprint",
    tagline: "4 to 6 weeks, idea to both stores",
    icon: "🚀",
    desc: "Your product idea turned into a working app on the App Store and Play Store. Weekly demo builds so you see progress every week, with analytics and crash reporting wired in from day one.",
    forWho: "Founders who need to validate a product with real users, without hiring a team or waiting six months.",
    includes: [
      "Scope definition and technical planning",
      "Flutter app for iOS and Android from one codebase",
      "Weekly demo builds you can put in testers' hands",
      "Analytics and crash reporting from the first release",
      "App Store and Play Store submission handled"
    ],
    badge: "MOST POPULAR",
    highlighted: true
  },
  {
    name: "Ongoing Development",
    tagline: "Monthly retainer",
    icon: "🔄",
    desc: "Dedicated development capacity for a product that's already live. This is how I work with Outfit Formulas today: continuous features, releases, and maintenance as the product grows.",
    forWho: "Products with real users that need a reliable senior developer without the overhead of a full-time hire.",
    includes: [
      "Feature development on a steady cadence",
      "Store releases, monitoring, and crash triage",
      "Flutter and dependency upgrades handled",
      "Direct async access, no account managers",
      "Priority response when something breaks"
    ]
  }
];

const faqs = [
  {
    q: "How do you charge?",
    a: "We start with a short call about scope, then I send a fixed quote for audits and MVP sprints, or a monthly rate for ongoing work. No surprises mid-project: if scope changes, we agree on the change before I build it."
  },
  {
    q: "What timezone do you work in?",
    a: "I'm based in India (IST) and work with clients in the US, Canada, and Europe. My working hours overlap with European mornings and US evenings, and most communication is async anyway, so timezone has never been a blocker for my clients."
  },
  {
    q: "Who owns the code?",
    a: "You do, always. Code lives in your repositories, accounts stay in your name, and everything I build is your IP. If we stop working together, you lose nothing."
  },
  {
    q: "Do you sign NDAs?",
    a: "Yes. Send yours over before the first call if you prefer, or I can work with a standard mutual NDA."
  },
  {
    q: "What happens after launch?",
    a: "Nothing ships and disappears. Every MVP sprint includes a handover, and most clients move to a maintenance arrangement or retainer so the app keeps improving after release."
  },
  {
    q: "How will I know what's happening during the project?",
    a: "Weekly demo builds you can actually open on your phone, plus short async updates. You'll never wonder what you're paying for."
  }
];

const services = [
  {
    title: "Flutter App Development",
    icon: "📱",
    desc: "Build high-performance, cross-platform mobile applications using Flutter. From concept to deployment, I deliver pixel-perfect apps that users love.",
    features: [
      "iOS & Android from single codebase",
      "Native performance & smooth animations",
      "Implementation from provided UI designs",
      "App Store & Play Store deployment",
      "Post-launch maintenance & updates"
    ],
    badge: "MOST POPULAR",
    highlighted: true
  },
  {
    title: "Enterprise Mobile Apps",
    icon: "🏢",
    desc: "Develop scalable enterprise-grade mobile applications with complex business logic, advanced features, and seamless user experiences.",
    features: [
      "Complex business logic implementation",
      "Third-party API integrations",
      "Real-time data synchronization",
      "Advanced security & authentication",
      "Performance optimization at scale"
    ],
    badge: "ENTERPRISE"
  },
  {
    title: "Web Development",
    icon: "🌐",
    desc: "Create modern, responsive web applications using cutting-edge frameworks. Perfect for landing pages, portfolios, and progressive web applications.",
    features: [
      "Responsive design for all devices",
      "SEO optimization & performance",
      "Modern framework implementation (Astro, React)",
      "Static site generation",
      "Analytics & tracking setup"
    ],
    badge: "NEW"
  },
  {
    title: "Code Optimization",
    icon: "⚡",
    desc: "Improve existing Flutter applications with performance optimization, code refactoring, and best practices implementation.",
    features: [
      "Performance analysis & optimization",
      "Code refactoring & clean architecture",
      "Memory leak detection & fixes",
      "UI/UX implementation improvements",
      "Testing & quality assurance"
    ]
  },
  {
    title: "Technical Consulting",
    icon: "💡",
    desc: "Leverage my Flutter expertise to make informed decisions about your mobile app architecture, technology choices, and development roadmap.",
    features: [
      "Flutter architecture review",
      "Technology stack recommendations",
      "Code quality audits",
      "Performance optimization strategies",
      "Development best practices guidance"
    ]
  },
  {
    title: "Maintenance & Support",
    icon: "🛠️",
    desc: "Keep your Flutter applications running smoothly with ongoing maintenance, updates, and technical support when you need it most.",
    features: [
      "Bug fixes & issue resolution",
      "Flutter version upgrades",
      "Performance monitoring",
      "Feature enhancements",
      "Technical support & troubleshooting"
    ]
  }
];
---

<BaseLayout
  title="Flutter Development Services | App Audit, MVP Sprint & Retainer"
  description="Three ways to work with me: a fixed-scope Flutter App Audit, a 4-6 week MVP Sprint from idea to both stores, or ongoing development on retainer. Book a call to discuss your project."
  sideBarActiveItemID="services"
>
  <!-- Premium Services Header -->
  <div class="relative py-16 mb-16 -mx-6 px-6 bg-gradient-to-br from-primary/5 via-secondary/5 to-accent/5 overflow-hidden">
    <!-- Background Effects -->
    <div class="absolute inset-0 bg-gradient-radial from-transparent via-base-100/30 to-base-100/60"></div>
    <div class="absolute top-10 right-10 w-48 h-48 bg-gradient-to-r from-primary/20 to-secondary/20 rounded-full blur-2xl opacity-30 animate-float-slow"></div>
    <div class="absolute bottom-10 left-10 w-64 h-64 bg-gradient-to-r from-accent/15 to-primary/15 rounded-full blur-3xl opacity-25 animate-float-medium"></div>
    
    <div class="relative z-10 text-center max-w-4xl mx-auto">
      <div class="mb-6 animate-fade-in">
        <span class="inline-flex items-center px-4 py-2 rounded-full bg-primary/10 border border-primary/20 text-primary font-medium text-sm">
          <span class="w-2 h-2 bg-primary rounded-full mr-2 animate-pulse"></span>
          Professional Services
        </span>
      </div>
      
      <h1 class="text-5xl md:text-7xl font-bold font-display mb-6 animate-slide-up">
        <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
          Services Offered
        </span>
      </h1>
      
      <p class="text-xl md:text-2xl text-base-content/70 max-w-3xl mx-auto leading-relaxed animate-fade-in" style="animation-delay: 0.3s;">
        Specialized Flutter development services to bring your mobile app ideas to life with expert implementation
      </p>
    </div>
  </div>

  <!-- Engagement Packages -->
  <div class="max-w-7xl mx-auto px-6 mb-24">
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-bold font-display mb-4">Three Ways to Work With Me</h2>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        Every engagement starts with a call. You tell me what you're building, I tell you honestly what it takes.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {packages.map((pkg) => (
        <div class={`card bg-base-100 border transition-all duration-300 hover:shadow-xl relative ${pkg.highlighted ? 'border-primary/40 shadow-lg shadow-primary/10' : 'border-base-content/10 hover:border-primary/30'}`}>
          {pkg.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class="badge badge-primary font-semibold px-4">{pkg.badge}</span>
            </div>
          )}
          <div class="card-body">
            <div class="text-4xl mb-2">{pkg.icon}</div>
            <h3 class="text-2xl font-bold">{pkg.name}</h3>
            <p class="text-sm font-medium text-primary mb-3">{pkg.tagline}</p>
            <p class="text-base-content/70 mb-4">{pkg.desc}</p>

            <div class="mb-4">
              <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">Who it's for</p>
              <p class="text-sm text-base-content/70">{pkg.forWho}</p>
            </div>

            <div class="mb-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-base-content/50 mb-2">What's included</p>
              <ul class="space-y-2">
                {pkg.includes.map((item) => (
                  <li class="flex items-start text-sm">
                    <svg class="w-4 h-4 text-success mt-0.5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span class="text-base-content/80">{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="card-actions mt-auto">
              <a href="/contact" class={`btn w-full ${pkg.highlighted ? 'btn-primary' : 'btn-outline'}`}>
                Book a Call
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Services Grid -->
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold font-display mb-4">Everything I Cover</h2>
      <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
        The full range of what these engagements can include
      </p>
    </div>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service, index) => (
        <div class="opacity-0 translate-y-8 service-card-container" style={`animation-delay: ${index * 0.1}s`}>
          <ServiceCard
            title={service.title}
            icon={service.icon}
            desc={service.desc}
            features={service.features}
            badge={service.badge}
            highlighted={service.highlighted}
          />
        </div>
      ))}
    </div>
  </div>

  <!-- Process Section -->
  <div class="py-20 mt-20 bg-gradient-to-b from-base-100 to-base-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold font-display mb-6 bg-gradient-to-r from-primary to-secondary bg-clip-text text-transparent">
          My Development Process
        </h2>
        <p class="text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed">
          A proven Flutter development methodology that ensures successful project delivery every time
        </p>
      </div>
      
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-primary/20 to-primary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-primary">1</span>
          </div>
          <h3 class="text-lg font-bold mb-2">Discovery</h3>
          <p class="text-sm text-base-content/70">Understanding your requirements and goals</p>
        </div>
        
        <div class="text-center group">
          <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-secondary/20 to-secondary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-secondary">2</span>
          </div>
          <h3 class="text-lg font-bold mb-2">Planning</h3>
          <p class="text-sm text-base-content/70">Architecture planning and technical specifications</p>
        </div>
        
        <div class="text-center group">
          <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-accent/20 to-accent/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-accent">3</span>
          </div>
          <h3 class="text-lg font-bold mb-2">Development</h3>
          <p class="text-sm text-base-content/70">Flutter implementation with best practices and clean code</p>
        </div>
        
        <div class="text-center group">
          <div class="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-primary/20 to-secondary/10 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <span class="text-3xl font-bold text-primary">4</span>
          </div>
          <h3 class="text-lg font-bold mb-2">Delivery</h3>
          <p class="text-sm text-base-content/70">Testing, deployment, and ongoing support</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="max-w-3xl mx-auto px-6 py-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold font-display mb-4">Questions Clients Ask</h2>
      <p class="text-lg text-base-content/70">
        The practical stuff, answered upfront
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <div class="collapse collapse-arrow bg-base-100 border border-base-content/10 rounded-xl">
          <input type="radio" name="services-faq" />
          <div class="collapse-title text-lg font-semibold">{faq.q}</div>
          <div class="collapse-content">
            <p class="text-base-content/70 leading-relaxed">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- CTA Section -->
  <div class="py-20 mt-20 -mx-6 px-6 bg-gradient-to-br from-primary/10 via-secondary/10 to-accent/10 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0 bg-gradient-to-r from-primary via-secondary to-accent animate-glow"></div>
    </div>
    
    <div class="relative z-10 max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-bold font-display mb-6 bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">
        Ready to Start Your Project?
      </h2>
      
      <p class="text-lg md:text-xl text-base-content/70 mb-10 leading-relaxed">
        Let's discuss how I can help bring your mobile app ideas to life with expert Flutter development
      </p>
      
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a href="/contact" class="btn btn-primary btn-lg px-10 py-3 rounded-full shadow-xl shadow-primary/30 hover:shadow-primary/50 transition-all duration-300 hover:scale-105 group">
          <span class="mr-2 font-semibold">Get a Quote</span>
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        
        <a href="/projects" class="btn btn-outline btn-lg px-10 py-3 rounded-full border-2 border-primary/30 hover:border-primary hover:bg-primary/10 hover:text-primary transition-all duration-300 hover:scale-105">
          View Portfolio
        </a>
      </div>
    </div>
  </div>

  <!-- Animation Styles -->
  <style>
    .service-card-container {
      animation: slideInUp 0.6s ease-out forwards;
    }
    
    @keyframes slideInUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</BaseLayout>