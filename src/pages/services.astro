---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/services/ServiceCard.astro";

const packages = [
  {
    name: "App & Architecture Audit",
    tagline: "Fixed scope, about 1 week",
    desc: "A deep review of your app and the backend behind it: architecture, data model, security, performance, and code quality. You get a written report with prioritized fixes you can act on immediately, whether or not we work together after.",
    forWho: "Teams with a product that feels slow, buggy, or hard to change, or founders who inherited a codebase and want to know what they're sitting on.",
    includes: [
      "App architecture and state management review",
      "Backend review: data model, security rules, functions, and API design",
      "Performance profiling of real problem screens and slow queries",
      "Written report with prioritized, actionable fixes",
      "A call to walk through the findings together"
    ]
  },
  {
    name: "MVP Sprint",
    tagline: "4 to 6 weeks, idea to both stores",
    desc: "Your product idea turned into a working app on the App Store and Play Store, with the backend it needs to run. Weekly demo builds so you see progress every week, with analytics and crash reporting wired in from day one.",
    forWho: "Founders who need to validate a product with real users, without hiring a team or waiting six months.",
    includes: [
      "Scope definition, data model, and technical planning",
      "Flutter app for iOS and Android from one codebase",
      "Backend on Firebase or Supabase: auth, database, rules, and functions",
      "Weekly demo builds you can put in testers' hands",
      "Analytics, crash reporting, and store submission handled"
    ],
    badge: "Most popular",
    highlighted: true
  },
  {
    name: "Ongoing Development",
    tagline: "Monthly retainer",
    desc: "Dedicated engineering capacity for a product that's already live, across the app, the backend, and AI features. This is how I work with Outfit Formulas today: continuous features, releases, and maintenance as the product grows.",
    forWho: "Products with real users that need a reliable senior engineer without the overhead of a full-time hire.",
    includes: [
      "Features shipped end to end, from data model to UI",
      "Store releases, backend deploys, monitoring, and crash triage",
      "Framework and dependency upgrades handled",
      "Direct async access, no account managers",
      "Priority response when something breaks"
    ]
  }
];

const faqs = [
  {
    q: "How do you charge?",
    a: "We start with a short call about scope, then I send a fixed quote for audits and MVP sprints, or a monthly rate for ongoing work. No surprises mid-project: if scope changes, we agree on the change before I build it."
  },
  {
    q: "What timezone do you work in?",
    a: "I'm based in India (IST) and work with clients in the US, Canada, and Europe. My working hours overlap with European mornings and US evenings, and most communication is async anyway, so timezone has never been a blocker for my clients."
  },
  {
    q: "Who owns the code?",
    a: "You do, always. Code lives in your repositories, accounts stay in your name, and everything I build is your IP. If we stop working together, you lose nothing."
  },
  {
    q: "Do you sign NDAs?",
    a: "Yes. Send yours over before the first call if you prefer, or I can work with a standard mutual NDA."
  },
  {
    q: "What happens after launch?",
    a: "Nothing ships and disappears. Every MVP sprint includes a handover, and most clients move to a maintenance arrangement or retainer so the app keeps improving after release."
  },
  {
    q: "How will I know what's happening during the project?",
    a: "Weekly demo builds you can actually open on your phone, plus short async updates. You'll never wonder what you're paying for."
  }
];

const steps = [
  { title: "Discovery", desc: "Understanding your users, your goals, and what the product has to do" },
  { title: "Planning", desc: "Architecture, data model, and the contracts between app and backend" },
  { title: "Development", desc: "Building the app, backend, and AI features, with weekly demo builds" },
  { title: "Delivery", desc: "Testing, store release, monitoring, and ongoing support" }
];

const services = [
  {
    title: "Mobile and web apps",
    desc: "Flutter apps for iOS, Android, and the web, taken from concept through store release, built with care for the small UX details.",
    features: [
      "iOS and Android from one Flutter codebase",
      "Flutter Web, including WASM builds",
      "Implementation from your designs, or UX input where there are none",
      "Payments and subscriptions with RevenueCat and Stripe",
      "App Store and Play Store releases"
    ],
    badge: "Most popular",
    highlighted: true
  },
  {
    title: "Backend and APIs",
    desc: "The server side your app depends on: data models, security, and business logic that hold up as usage grows.",
    features: [
      "Firestore and Supabase data modeling",
      "Security rules and ownership checks",
      "Cloud Functions in TypeScript and REST APIs",
      "Webhooks, scheduled jobs, and migrations on live data",
      "Real-time sync with WebSockets and listeners"
    ]
  },
  {
    title: "AI features",
    desc: "AI that does a real job inside your product, with output checked before it reaches users.",
    features: [
      "AI chat, tagging, and content generation with OpenAI and Gemini",
      "Prompt design with versioned prompts",
      "Validation and scoring of model output",
      "Timeouts and batch limits on every model call",
      "Privacy prompts before user content goes to AI providers"
    ],
    badge: "New"
  },
  {
    title: "System design and architecture",
    desc: "Structure that keeps a product easy to change: clear boundaries between app, backend, and admin tools.",
    features: [
      "Architecture for new products and rewrites",
      "Data contracts shared across app, backend, and admin panel",
      "Feature flags and staged rollouts",
      "Offline-first and cache-first data patterns",
      "Testing strategy for the parts that matter"
    ]
  },
  {
    title: "Performance and code health",
    desc: "Performance work and refactoring on existing apps, from profiling slow screens to untangling architecture.",
    features: [
      "Profiling and fixing slow screens and queries",
      "Refactoring toward clean architecture",
      "Memory leak detection and fixes",
      "Reducing backend read and compute costs",
      "Unit and widget test coverage"
    ]
  },
  {
    title: "Consulting and maintenance",
    desc: "A second opinion on your product, or a steady hand keeping a live app healthy.",
    features: [
      "Architecture and technology choices",
      "Code quality reviews",
      "Bug fixes and issue resolution",
      "Framework and dependency upgrades",
      "Monitoring and support when something breaks"
    ]
  }
];
---

<BaseLayout
  title="Services | Full-Stack App Development, Flutter & AI"
  description="Flutter apps, backends, AI features, and system design. Start with a fixed-scope audit, a 4-6 week MVP Sprint, or ongoing development on retainer."
  sideBarActiveItemID="services"
>
  <header class="pb-16 pt-4 sm:pb-20">
    <h1 class="text-4xl font-semibold sm:text-5xl">Services</h1>
    <p class="mt-5 max-w-[60ch] text-lg leading-relaxed text-base-content/65 sm:text-xl">
      App, backend, and AI development for founders and teams: audits, MVPs, and long-term product work
    </p>
  </header>

  <section aria-labelledby="packages-title">
    <h2 id="packages-title" class="text-2xl font-semibold sm:text-3xl">Three ways to work with me</h2>
    <p class="mt-3 max-w-[60ch] text-base-content/60">
      Every engagement starts with a call. You tell me what you're building, I tell you honestly what it takes.
    </p>

    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {packages.map((pkg) => (
        <article class:list={[
          "flex flex-col rounded-xl border bg-base-200 p-6 sm:p-7",
          pkg.highlighted ? "border-primary/60" : "border-base-300",
        ]}>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-xl font-semibold">{pkg.name}</h3>
            {pkg.badge && <span class="whitespace-nowrap text-sm font-medium text-primary">{pkg.badge}</span>}
          </div>
          <p class="mt-1 text-sm text-base-content/55">{pkg.tagline}</p>
          <p class="mt-5 text-[15px] leading-relaxed text-base-content/75">{pkg.desc}</p>

          <h4 class="mt-6 text-sm font-medium text-base-content">Who it's for</h4>
          <p class="mt-1.5 text-[15px] leading-relaxed text-base-content/60">{pkg.forWho}</p>

          <h4 class="mt-6 text-sm font-medium text-base-content">What's included</h4>
          <ul class="mt-2 space-y-2 text-[15px] text-base-content/70">
            {pkg.includes.map((item) => (
              <li class="flex gap-3">
                <span class="mt-[0.6em] h-px w-3 flex-shrink-0 bg-base-content/35" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-8">
            {pkg.highlighted ? (
              <a href="/contact" class="block rounded-lg bg-primary px-5 py-3 text-center font-medium text-primary-content transition-opacity hover:opacity-90">Book a call</a>
            ) : (
              <a href="/contact" class="block rounded-lg border border-base-300 px-5 py-3 text-center font-medium text-base-content transition-colors hover:border-base-content/40">Book a call</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-28" aria-labelledby="cover-title">
    <h2 id="cover-title" class="text-2xl font-semibold sm:text-3xl">Everything I cover</h2>
    <p class="mt-3 max-w-[60ch] text-base-content/60">The full range of what these engagements can include</p>
    <ul class="mt-8 border-t border-base-300">
      {services.map((service) => (
        <li class="border-b border-base-300">
          <ServiceCard
            title={service.title}
            desc={service.desc}
            features={service.features}
            badge={service.badge}
            highlighted={service.highlighted}
          />
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-28" aria-labelledby="process-title">
    <h2 id="process-title" class="text-2xl font-semibold sm:text-3xl">My development process</h2>
    <p class="mt-3 max-w-[60ch] text-base-content/60">
      The same four steps on every project, whether it's a one-week audit or an ongoing retainer
    </p>
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="border-t border-base-300 pt-5">
          <span class="text-sm tabular-nums text-base-content/45">Step {i + 1}</span>
          <h3 class="mt-1 font-medium">{step.title}</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-base-content/60">{step.desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-28 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16" aria-labelledby="faq-title">
    <div>
      <h2 id="faq-title" class="text-2xl font-semibold sm:text-3xl">Questions clients ask</h2>
      <p class="mt-3 text-base-content/60">The practical stuff, answered upfront</p>
    </div>
    <div class="border-t border-base-300">
      {faqs.map((faq) => (
        <details class="faq group border-b border-base-300">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 font-medium">
            <span>{faq.q}</span>
            <svg class="h-4 w-4 flex-shrink-0 text-base-content/50 transition-transform group-open:rotate-45" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="max-w-[62ch] pb-6 leading-relaxed text-base-content/65">{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mt-28 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12 sm:py-16" aria-labelledby="cta-title">
    <h2 id="cta-title" class="max-w-[20ch] text-3xl font-semibold sm:text-4xl">Ready to start your project?</h2>
    <p class="mt-4 max-w-[52ch] text-base-content/65">
      A short call is enough to scope most projects. Get a quote, or just ask questions.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Get a quote</a>
      <a href="/projects" class="link-quiet font-medium">View portfolio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .faq summary::-webkit-details-marker { display: none; }
</style>
