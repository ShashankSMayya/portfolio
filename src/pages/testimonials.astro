---
import BaseLayout from "../layouts/BaseLayout.astro";
import TestimonialCard from "../components/testimonials/TestimonialCard.astro";


const joshTestimonial = 'I have had the pleasure of working with Shashank on multiple projects, and his expertise and\n' +
    'dedication have been crucial to our operations. Shashank built a comprehensive web app using\n' +
    'Flutter that seamlessly supports all our corporate operations. His work doesn\'t stop there; he\n' +
    'has also developed numerous small-scale tools that have been integrated into our suite of\n' +
    'technologies under our own IP. Shashank delivers high-quality solutions consistently, along with\n' +
    'his smart approach\'s and attention to detail, has greatly contributed to our success.\n' +
    'We no longer search elsewhere for development needs; Shashank is our go-to expert for\n' +
    'everything. I highly recommend Shashank for any development projects and look forward to\n' +
    'continuing our collaboration.'

const shazadTestimonial = 'Working with Shashank Mayya has been an absolute pleasure. His dedication to timely delivery, unwavering commitment to quality, and penchant for taking the lead have consistently impressed us. Shashank embodies ownership in every task he undertakes, ensuring that projects are not just completed, but completed to perfection. His attention to detail and drive for excellence have been instrumental in our successes while collaborating with him. Shashank\'s contributions have undoubtedly elevated our projects, and his professionalism sets a standard for teamwork and achievement. We highly recommend Shashank Mayya for any endeavor requiring expertise, reliability, and a steadfast commitment to excellence.';


const abhilashTestimonial = 'Shashank was an exceptional asset to the Mello Project. His technical skills and user-centric approach were instrumental in creating a smooth and engaging app experience. He consistently impressed us with his ability to think like an end user, anticipating their needs and incorporating valuable insights into the development process. Shashank\'s expertise in Flutter development was evident throughout the project. He delivered a highly functional app with minimal bugs, ensuring a seamless user experience from day one. His excellent communication skills kept us informed and ensured a collaborative working relationship. I would also like to add that for anyone looking to work with him, he seems to be an exceptional candidate with some really good developer skills along with communication which many developers lack.';
---


<BaseLayout 
  title="Client Testimonials | Shashank S Mayya"
  description="What CTOs and founders say about working with me on their apps, in their own words."
  sideBarActiveItemID="testimonials"
>
    <header class="pb-6 pt-2">
        <h1 class="text-4xl font-semibold sm:text-5xl">What clients say</h1>
        <p class="mt-4 max-w-[60ch] text-lg leading-relaxed text-base-content/65">
            In their own words: the CTOs and founders I've built apps for.
        </p>
    </header>

    <div class="divide-y divide-base-300 border-y border-base-300">
        <TestimonialCard
            img="/testimonials/josh.webp"
            name="Joshua Boyd"
            role="Operations Manager"
            company="Van Auto Credit"
            location="Vancouver, Canada"
            testimonial={joshTestimonial}
        />
        <TestimonialCard
            img="/testimonials/shazad.webp"
            name="Shazad Maved"
            role="Chief Technology Officer"
            company="Mindstack Technologies"
            location="Mangaluru, India"
            testimonial={shazadTestimonial}
        />
        <TestimonialCard
            img="/testimonials/abhilash.webp"
            name="Abhilash"
            role="Chief Technology Officer"
            company="Mello"
            location="Bengaluru, India"
            testimonial={abhilashTestimonial}
        />
    </div>

    <section class="mt-20 rounded-2xl border border-base-300 bg-base-200 px-6 py-12 sm:px-12 sm:py-14" aria-labelledby="testimonials-cta">
        <h2 id="testimonials-cta" class="text-3xl font-semibold">Working on something similar?</h2>
        <p class="mt-3 max-w-[52ch] text-base-content/65">Book a call and tell me what you're building.</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a href="/contact" class="rounded-lg bg-primary px-5 py-3 font-medium text-primary-content transition-opacity hover:opacity-90">Book a call</a>
            <a href="/projects" class="link-quiet font-medium">See my work</a>
        </div>
    </section>
</BaseLayout>